import pandas as pd
import numpy as np
import os
from plotting_utils import create_error_plot

RESULTS_CSV_PATH = "full_experiment_results.csv"
PLOTS_DIR = "analysis_plots"

def analyze_and_plot(df):
    """Función principal para generar todos los análisis y plots."""
    if df.empty:
        print("El DataFrame de resultados está vacío. No se pueden generar análisis.")
        return

    os.makedirs(PLOTS_DIR, exist_ok=True)

    if 'mic_pair' not in df.columns:
        print("Error: La columna 'mic_pair' no se encuentra en el CSV.")
        return

    df_tdoa_pairs = df[df['mic_pair'] != 'array_avg_adj_pairs'].copy()
    df_doa_array = df[df['mic_pair'] == 'array_avg_adj_pairs'].copy()

    # --- Ejemplo 1: TDOA Error (CC) vs SNR usando create_error_plot ---
    method_cc_tdoa = 'cc'
    if 'tdoa_method' in df_tdoa_pairs.columns:
        df_method_cc_tdoa = df_tdoa_pairs[df_tdoa_pairs['tdoa_method'] == method_cc_tdoa].copy()

        if not df_method_cc_tdoa.empty:
            print(f"\nGenerando gráfico para TDOA method {method_cc_tdoa} vs SNR...")
            create_error_plot(
                df_full=df_method_cc_tdoa,
                x_col='snr_db',
                y_col='tdoa_error_s',
                title=f'Error TDOA ({method_cc_tdoa.upper()}) vs. SNR',
                output_filename=f'tdoa_error_{method_cc_tdoa}_vs_snr.png',
                plot_type='lineplot_ci',
                hue_col=None,
                is_angular_error=False,
                ylim_strategy='percentile',
                ylim_params={'low': 1, 'high': 99, 'min_range_abs': 0.00005}, # 50 µs
                x_label='SNR (dB)',
                y_label='Error Absoluto TDOA (s)',
                output_dir=PLOTS_DIR,
                lineplot_estimator='median',
                lineplot_ci=95
            )
        else:
            print(f"No hay datos para TDOA method {method_cc_tdoa} para graficar vs SNR.")
    else:
        print("Advertencia: Columna 'tdoa_method' no encontrada en df_tdoa_pairs.")

    # --- Ejemplo 2: DOA Array Error (base CC) vs SNR usando create_error_plot ---
    method_cc_doa = 'cc'
    if 'tdoa_method_for_avg_doa' in df_doa_array.columns:
        df_method_cc_doa = df_doa_array[df_doa_array['tdoa_method_for_avg_doa'] == method_cc_doa].copy()

        if not df_method_cc_doa.empty:
            print(f"\nGenerando gráfico para DOA Array (base {method_cc_doa}) vs SNR...")
            create_error_plot(
                df_full=df_method_cc_doa,
                x_col='snr_db',
                y_col='doa_array_error_deg',
                title=f'Error DOA Array (base {method_cc_doa.upper()}) vs. SNR',
                output_filename=f'doa_array_error_{method_cc_doa}_vs_snr.png',
                plot_type='lineplot_ci',
                is_angular_error=True,
                ylim_strategy='percentile',
                ylim_params={'low': 1, 'high': 99, 'min_range_abs': 5}, # 5 grados
                x_label='SNR (dB)',
                y_label='Error Absoluto DOA (grados)',
                output_dir=PLOTS_DIR,
                lineplot_estimator='median',
                lineplot_ci=95
            )
        else:
            print(f"No hay datos para DOA Array (base {method_cc_doa}) para graficar vs SNR.")
    else:
        print("Advertencia: Columna 'tdoa_method_for_avg_doa' no encontrada en df_doa_array.")

    print(f"\n--- Gráficos de ejemplo generados en {PLOTS_DIR} (si los datos lo permitieron) ---")
    print("Por favor, revisa tdoa_error_cc_vs_snr.png y doa_array_error_cc_vs_snr.png.")
    print("El resto de los gráficos de la función original no se generarán en este paso.")

if __name__ == "__main__":
    print("--- Iniciando script de análisis de resultados (versión de prueba para ejemplos) ---")
    if not os.path.exists(RESULTS_CSV_PATH):
        print(f"Error: Archivo de resultados no encontrado: {RESULTS_CSV_PATH}. Ejecute main.py primero.")
    else:
        try:
            main_results_df = pd.read_csv(RESULTS_CSV_PATH)
            print(f"Resultados cargados: {len(main_results_df)} filas.")
            if main_results_df.empty:
                print("Advertencia: El archivo CSV de resultados está vacío.")
            else:
                analyze_and_plot(main_results_df)
        except pd.errors.EmptyDataError:
            print(f"Error: El archivo de resultados {RESULTS_CSV_PATH} está vacío o corrupto.")
        except Exception as e:
            print(f"Ocurrió un error al procesar el archivo de resultados: {e}")
